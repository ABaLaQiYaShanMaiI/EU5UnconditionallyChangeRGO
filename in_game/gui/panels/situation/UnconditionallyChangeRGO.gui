situation_panel = {

	blockoverride "situation_subheader_content" { }

	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_UnconditionallyChangeRGO')]"
		}
	}

	# ============================================================
	# 采用最初版本的骨架：vbox(datamodel) → item → scrollarea → fixedgridbox
	# 只是把按钮类型换成 EU5 真实存在的 targetted_button_regular，
	# 点击/长按确认沿用官方动作按钮的 scripted_action_tooltip 写法。
	# 行高 30px、区高 560px：当前 10 个按钮 ≈ 300px，一屏放得下，不需要拖动。
	# ============================================================
	blockoverride "situation_panel_main_content" {
		vbox = {
			visible = "[Not(IsDataModelEmpty(SituationView.GetActionGroups))]"
			datamodel = "[SituationView.GetActionGroups]"

			item = {
				widget = {
					layoutpolicy_vertical = expanding
					size = { 500 560 }

					scrollarea = {
						layoutpolicy_vertical = expanding
						size = { 500 560 }
						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}

						scrollwidget = {
							fixedgridbox = {
								addrow = 30
								addcolumn = 480

								datamodel = "[ActionGroup.GetActions]"

								item = {
									widget = {
										size = { 480 30 }

										targetted_button_regular = {
											name = "rgo_action_button"
											size = { 476 28 }
											parentanchor = top

											text = "[GenericAction.GetNameWithNoTooltip]"
											# 注意：自绘按钮上 IsUberButtonEnabled 可能求值为 false 导致整个按钮禁用（点不动），
											# 因此不写 enabled；冷却期间点击会由动作自身的 allow 拒绝并给出提示。

											button_tooltip_override = {
												title = "[GenericAction.GetName]"
											}

											scripted_action_tooltip = {
												click_type = left
												click_mode = single
												action_name = "[GenericAction.GetLeftClickKey]"
												actor = "[SituationView.GetPlayer]"
												parameter = {
													parameter_name = "recipient"
													parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
												}
											}

											scripted_action_tooltip = {
												click_type = left
												click_mode = confirm
												action_name = "[GenericAction.GetLeftClickAndHoldKey]"
												actor = "[SituationView.GetPlayer]"
												parameter = {
													parameter_name = "recipient"
													parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
												}
											}

											blockoverride "tooltip" {
												tooltipwidget = {
													ContextualTooltipType = {
														blockoverride "title_text" {
															text = "[GenericAction.GetNameWithNoTooltip]"
														}
														blockoverride "concept_link" {
															text = "[situation|e]"
														}
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "[SituationView.GetActiveSituation.GetIcon]"
															}
														}
														blockoverride "tooltip_content" {
															using = action_tooltip_inner_content
															blockoverride "conditions_list" { }
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
