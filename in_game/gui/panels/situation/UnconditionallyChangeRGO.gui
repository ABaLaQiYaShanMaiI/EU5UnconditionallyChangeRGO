situation_panel = {

	blockoverride "situation_subheader_content" { }

	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_UnconditionallyChangeRGO')]"
		}
	}

	# ============================================================
	# 官方方案：直接使用模板 situations_actions
	# - 按钮 100% 由引擎生成：可点击、长按确认、冷却置灰、分类隐藏都由引擎处理
	# - 顺序：分类动作 RGO_change_*（7 个）在前，开关动作 RGO_toggle_*（10 个）在后
	# ============================================================
	blockoverride "situation_panel_main_actions" {
		vbox = {
			layoutpolicy_horizontal = expanding

			using = situations_actions
		}
	}
}
