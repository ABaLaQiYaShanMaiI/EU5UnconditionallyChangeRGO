# 单个动作按钮（分类 / 开关共用；两列布局，一格 234x30，按钮 230x28）
template rgo_action_button {
	targetted_button_regular = {
		size = { 230 28 }
		parentanchor = top

		text = "[GenericAction.GetNameWithNoTooltip]"

		button_tooltip_override = {
			title = "[GenericAction.GetName]"
		}

		scripted_action_tooltip = {
			click_type = left
			click_mode = single
			action_name = "[GenericAction.GetLeftClickKey]"
			actor = "[SituationView.GetPlayer]"
			parameter = {
				parameter_name = "recipient"
				parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
			}
		}

		scripted_action_tooltip = {
			click_type = left
			click_mode = confirm
			action_name = "[GenericAction.GetLeftClickAndHoldKey]"
			actor = "[SituationView.GetPlayer]"
			parameter = {
				parameter_name = "recipient"
				parameter_value = "[SituationView.GetActiveSituation.GetSituation]"
			}
		}

		blockoverride "tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "[GenericAction.GetNameWithNoTooltip]"
					}
					blockoverride "concept_link" {
						text = "[situation|e]"
					}
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "[SituationView.GetActiveSituation.GetIcon]"
						}
					}
					blockoverride "tooltip_content" {
						using = action_tooltip_inner_content
						blockoverride "conditions_list" { }
					}
				}
			}
		}
	}
}

# ============================================================
# 局势面板
#
# 按钮外壳仍用引擎内建的 situation_card_actions（原生卡片背景与标题）。
# 关键：situation_card_actions 自己已经 blockoverride 了 "actions_override"，
# 所以在实例上再覆盖它无效（列表会退回原版单列 + 卡片内滚动条）。
# 原版 gui/panels/situation/black_death.gui 的正确写法是覆盖它内部那个
# block "situation_card_action_list"，本文件照此实现。
#
#   [分类 两列，最多 4 行]  →  18px 间隔  →  [开关 两列，2 行]
#
# 分组用 DataModelSubSpan(源, 起始索引, 数量) 逐个切片（原版 hre.gui /
# heir_selection.gui 就是用这个做多列），所以不写死条目总数：
#   分类 = 索引 0 起逐个取（分类数由 tools/rgo_common.ps1 决定）
#   开关 = 末尾若干个，用 GetDataModelSize(源) - k 反推起始索引
# 隐藏制成品时动作列表变短，最后一行的空格子自然为空，不会留下空行。
#
# 为什么关掉 situation_panel_main_actions：否则同一面板会出现两份按钮。
# ============================================================
situation_panel = {

	blockoverride "situation_subheader_content" { }

	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_UnconditionallyChangeRGO')]"
		}
	}

	# 关掉引擎默认的动作卡片，避免与下面的自定义卡片重复
	blockoverride "situation_panel_main_actions" { }

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[Not(IsDataModelEmpty(SituationView.GetActionGroups))]"
			datamodel = "[SituationView.GetActionGroups]"

			item = {
				widget = {
					situation_card_actions = {
						set_parent_size_to_minimum = yes

						# 默认标题是引擎 UI 库的占位文字（IOs Card important title header），
						# 默认图标也是占位图例里的拳头，这里都换成自己的
						blockoverride "card_header_icon" { visible = no }
						blockoverride "card_header_text" {
							text = "RGO_CARD_HEADER"
						}

						blockoverride "situation_card_action_list" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								margin = { 0 4 }

								# ============ 分类：两列 ============
								# 第 1 行：分类 1、2
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)0', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)1', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
								}

								# 第 2 行：分类 3、4
								# visible：可见分类数（= 动作总数 - 开关数）不足 3 个时整行隐藏，避免取到开关按钮
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									visible = "[GreaterThan_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)6')]"
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)2', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)3', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
								}

								# 第 3 行：分类 5、6
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									visible = "[GreaterThan_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)8')]"
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)4', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)5', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
								}

								# 第 4 行：分类 7（制成品）
								# visible：只有 7 个分类都在时才显示，否则这一格会取到第一个开关（花费开关）
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									visible = "[GreaterThan_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)10')]"
									vbox = { size = { 234 -1 } datamodel = "[DataModelSubSpan(ActionGroup.GetActions, '(int32)6', '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
								}

								# ============ 分类与开关之间的间隔 ============
								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 18 }
								}

								# ============ 开关：两列 ============
								# 第 1 行：倒数第 4、3 个动作
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, Subtract_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)4'), '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, Subtract_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)3'), '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
								}

								# 第 2 行：倒数第 2、1 个动作
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, Subtract_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)2'), '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
									vbox = { layoutpolicy_horizontal = expanding datamodel = "[DataModelSubSpan(ActionGroup.GetActions, Subtract_int32(GetDataModelSize(ActionGroup.GetActions), '(int32)1'), '(int32)1')]" item = { widget = { size = { 234 30 } using = rgo_action_button } } }
								}
							}
						}
					}
				}
			}
		}
	}
}
